# Copy to .env and fill in. .env is git-ignored and must never be committed or uploaded.

# --- Nova Shield Core ---
SHIELD_HOST=127.0.0.1
SHIELD_PORT=4000
# Admin key for the Shield Console and admin API (24+ random characters)
SHIELD_ADMIN_KEY=
# One key per app, comma-separated appId:key pairs (each key 24+ random characters)
SHIELD_APP_KEYS=demo:

# --- Demo app (plugs into Core with the middleware) ---
DEMO_PORT=3000
SHIELD_CORE_URL=http://127.0.0.1:4000
SHIELD_APP_KEY=

# --- HELIX pilot (apps/helix) ---
HELIX_PORT=4100
# The key you gave "helix" in SHIELD_APP_KEYS
HELIX_SHIELD_APP_KEY=
HELIX_USERNAME=
# Make with: npm run hash-password -- "your password"
HELIX_PASSWORD_HASH=
# Path to the HELIX Console page, e.g. C:\Users\you\NovaSite\rag7\nova-digitus-site\try\helix-console\index.html
HELIX_CONSOLE_FILE=
