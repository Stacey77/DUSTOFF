# Server
NRB_HOST=127.0.0.1
NRB_PORT=8080

# Monitoring
NRB_POLL_INTERVAL=30
NRB_DEGRADE_LATENCY_MS=250
NRB_FAIL_THRESHOLD=2

# Remediation — set false to execute REAL network commands
NRB_SAFE_MODE=true

# Alerting (Slack/Teams/generic webhook URL) + escalation threshold
# NRB_ALERT_WEBHOOK=https://hooks.slack.com/services/...
NRB_ESCALATE_AFTER=3

# Auth — when set, mutating endpoints require X-API-Key: <admin key>
# NRB_ADMIN_KEY=change-me
# NRB_VIEWER_KEY=read-only-key

# Optional LLM planner for the brain (OpenAI-compatible)
# NRB_LLM_PLANNER=false
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# NRB_LLM_MODEL=gpt-4o-mini
